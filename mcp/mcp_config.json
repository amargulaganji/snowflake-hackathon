{
  "mcpServers": {
    "SnowCare360-slack": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic-ai/mcp-server-slack"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      }
    },
    "SnowCare360-gdrive": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic-ai/mcp-server-gdrive"
      ],
      "env": {
        "GDRIVE_CREDENTIALS": "${GDRIVE_CREDENTIALS}"
      }
    },
    "SnowCare360-filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@anthropic-ai/mcp-server-filesystem",
        "./exports"
      ]
    }
  }
}
